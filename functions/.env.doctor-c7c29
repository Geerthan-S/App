# Deploy-time settings for project doctor-c7c29 (loaded by the Firebase CLI).
# Both switches default to ON in code. They are OFF here only until the console
# setup in docs/runbooks/admin-v2-security-setup.md is done; then set them to
# true (or delete these lines) and redeploy functions.
REQUIRE_STAFF_MFA=false
ENFORCE_APP_CHECK=false

# CLIENT REVIEW TESTING MODE (2026-10): approvals do not require uploaded,
# virus-scanned documents (no scanner is provisioned). The app and admin portal
# show a "Testing mode" notice while this is false. Delete this line (or set it
# to true) and redeploy functions once the client review is finished.
REQUIRE_VERIFICATION_EVIDENCE=false
