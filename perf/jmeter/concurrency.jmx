<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Double-booking concurrency" enabled="true"><stringProp name="TestPlan.comments">Race 1: N selections fire at the same instant for a duty with one seat. Race 2: N hospitals select the same doctor for overlapping shifts at the same instant. Each race must produce exactly one assignment.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Endpoints (override with -J or -q cloud.properties)" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="project" elementType="Argument"><stringProp name="Argument.name">project</stringProp><stringProp name="Argument.value">${__P(project,demo-healthforce)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="functions_url" elementType="Argument"><stringProp name="Argument.name">functions_url</stringProp><stringProp name="Argument.value">${__P(functions_url,http://127.0.0.1:5001/demo-healthforce/us-central1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="auth_url" elementType="Argument"><stringProp name="Argument.name">auth_url</stringProp><stringProp name="Argument.value">${__P(auth_url,http://127.0.0.1:9099/identitytoolkit.googleapis.com/v1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="firestore_host" elementType="Argument"><stringProp name="Argument.name">firestore_host</stringProp><stringProp name="Argument.value">${__P(firestore_host,http://127.0.0.1:8080)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="api_key" elementType="Argument"><stringProp name="Argument.name">api_key</stringProp><stringProp name="Argument.value">${__P(api_key,fake-api-key)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="data_dir" elementType="Argument"><stringProp name="Argument.name">data_dir</stringProp><stringProp name="Argument.value">${__P(data_dir,../data)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree></hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Derived endpoints" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="firestore_docs" elementType="Argument"><stringProp name="Argument.name">firestore_docs</stringProp><stringProp name="Argument.value">${firestore_host}/v1/projects/${project}/databases/(default)/documents</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree></hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON content type" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Prepare race fixtures" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp></SetupThreadGroup><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Create duties, applications and tokens" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename">lib/race_setup.groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script"></stringProp></JSR223Sampler><hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Race 1: many hospitals' picks for ONE seat" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(seat_threads,30)}</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp></ThreadGroup><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Race 1: many hospitals' picks for ONE seat: atomicSelectDoctor" enabled="true"><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">${functions_url}/atomicSelectDoctor</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">15000</stringProp><stringProp name="HTTPSampler.response_timeout">60000</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"data": {"dutyId": "${race_duty}", "doctorId": "${race_doctor}", "idempotencyKey": "${__UUID()}"}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth header" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${race_token}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Expect: allow=OK,DUTY_CAPACITY_FILLED,INVALID_STATE_TRANSITION" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">allow=OK,DUTY_CAPACITY_FILLED,INVALID_STATE_TRANSITION</stringProp><stringProp name="filename">lib/expect.groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script"></stringProp></JSR223Assertion><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick this thread's contender" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">seat</stringProp><stringProp name="filename">lib/race_pick.groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script"></stringProp></JSR223PreProcessor><hashTree></hashTree><SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Release all threads at once" enabled="true"><intProp name="groupSize">0</intProp><longProp name="timeoutInMs">60000</longProp></SyncTimer><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Tally outcome" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">seat</stringProp><stringProp name="filename">lib/race_tally.groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script"></stringProp></JSR223Assertion><hashTree></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Race 2: many hospitals select ONE doctor for overlapping shifts" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(doctor_threads,20)}</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp></ThreadGroup><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Race 2: many hospitals select ONE doctor for overlapping shifts: atomicSelectDoctor" enabled="true"><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">${functions_url}/atomicSelectDoctor</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">15000</stringProp><stringProp name="HTTPSampler.response_timeout">60000</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"data": {"dutyId": "${race_duty}", "doctorId": "${race_doctor}", "idempotencyKey": "${__UUID()}"}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth header" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${race_token}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Expect: allow=OK,ASSIGNMENT_CONFLICT" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">allow=OK,ASSIGNMENT_CONFLICT</stringProp><stringProp name="filename">lib/expect.groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script"></stringProp></JSR223Assertion><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223P