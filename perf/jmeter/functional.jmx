<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Functional API checks" enabled="true"><stringProp name="TestPlan.comments">One pass over the API: sign-in, duty lifecycle, idempotency replays, authorization and validation. Every sample must pass.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Endpoints (override with -J or -q cloud.properties)" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="project" elementType="Argument"><stringProp name="Argument.name">project</stringProp><stringProp name="Argument.value">${__P(project,demo-healthforce)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="functions_url" elementType="Argument"><stringProp name="Argument.name">functions_url</stringProp><stringProp name="Argument.value">${__P(functions_url,http://127.0.0.1:5001/demo-healthforce/us-central1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="auth_url" elementType="Argument"><stringProp name="Argument.name">auth_url</stringProp><stringProp name="Argument.value">${__P(auth_url,http://127.0.0.1:9099/identitytoolkit.googleapis.com/v1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="firestore_host" elementType="Argument"><stringProp name="Argument.name">firestore_host</stringProp><stringProp name="Argument.value">${__P(firestore_host,http://127.0.0.1:8080)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="api_key" elementType="Argument"><stringProp name="Argument.name">api_key</stringProp><stringProp name="Argument.value">${__P(api_key,fake-api-key)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="data_dir" elementType="Argument"><stringProp name="Argument.name">data_dir</stringProp><stringProp name="Argument.value">${__P(data_dir,../data)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree></hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Derived endpoints" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="firestore_docs" elementType="Argument"><stringProp name="Argument.name">firestore_docs</stringProp><stringProp name="Argument.value">${firestore_host}/v1/projects/${project}/databases/(default)/documents</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree></hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON content type" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Functional pass (1 user, runs once)" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp></ThreadGroup><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load seeded accounts" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def fb = evaluate(new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), 'lib/firebase.groovy'))
def doctor = fb.csv('doctors.csv')[0]
vars.put('doctor_uid', doctor.uid)
vars.put('doctor_email', doctor.email)
vars.put('doctor_password', doctor.password)
vars.put('doctor_org', doctor.organizationId)
vars.put('doctor_facility', doctor.facilityId)
def doctor2 = fb.csv('doctors.csv')[1]
vars.put('doctor2_uid', doctor2.uid)
vars.put('doctor2_email', doctor2.email)
vars.put('doctor2_password', doctor2.password)
vars.put('doctor2_org', doctor2.organizationId)
vars.put('doctor2_facility', doctor2.facilityId)
def hospital = fb.csv('hospitals.csv')[0]
vars.put('hospital_uid', hospital.uid)
vars.put('hospital_email', hospital.email)
vars.put('hospital_password', hospital.password)
vars.put('hospital_org', hospital.organizationId)
vars.put('hospital_facility', hospital.facilityId)
def other = fb.csv('hospitals.csv')[2]
vars.put('other_uid', other.uid)
vars.put('other_email', other.email)
vars.put('other_password', other.password)
vars.put('other_org', other.organizationId)
vars.put('other_facility', other.facilityId)
def admin = fb.csv('admins.csv')[0]
vars.put('admin_uid', admin.uid)
vars.put('admin_email', admin.email)
vars.put('admin_password', admin.password)
vars.put('admin_org', admin.organizationId)
vars.put('admin_facility', admin.facilityId)
SampleResult.setIgnore()</stringProp></JSR223Sampler><hashTree></hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Idempotency keys for this run" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="apply_key" elementType="Argument"><stringProp name="Argument.name">apply_key</stringProp><stringProp name="Argument.value">${__UUID()}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="select_key" elementType="Argument"><stringProp name="Argument.name">select_key</stringProp><stringProp name="Argument.value">${__UUID()}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="confirm_key" elementType="Argument"><stringProp name="Argument.name">confirm_key</stringProp><stringProp name="Argument.value">${__UUID()}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Auth: sign in doctor" enabled="true"><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">${auth_url}/accounts:signInWithPassword?key=${api_key}</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">15000</stringProp><stringProp name="HTTPSampler.response_timeout">60000</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"email": "${doctor_email}",