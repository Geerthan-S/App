</boolProp><stringProp name="Argument.value">{"data": {"organizationId": "${hospital_org}", "facilityId": "${hospital_facility}", "facilityName": "Ignored by server", "city": "Ignored by server", "department": "Casualty", "specialtyId": "general_medicine", "specialtyName": "General Medicine", "qualificationRequired": "MBBS", "experienceMinYears": 0, "schedule": {"startAt": "${__timeShift(yyyy-MM-dd'T'HH:00:00.000'Z',,P45D,,)}", "endAt": "${__timeShift(yyyy-MM-dd'T'HH:00:00.000'Z',,P45DT6H,,)}", "shiftType": "morning"}, "headcount": 1, "paymentTerms": {"amount": 4000, "currency": "INR", "basis": "per_shift", "expectedPaymentTiming": "end_of_shift"}}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth header" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${hospital_token}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Expect: ok" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">ok</stringProp><stringProp name="filename">lib/expect.groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script"></stringProp></JSR223Assertion><hashTree></hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract duty_id" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">duty_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.result.dutyId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp></JSONPostProcessor><hashT