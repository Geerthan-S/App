rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REUSABLE HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token.get(claim, false) == true;
    }

    function isVerifier() {
      return hasCustomClaim('isVerifier') || hasCustomClaim('isSuperAdmin');
    }

    function isSupportAdmin() {
      return hasCustomClaim('isSupportAdmin') || hasCustomClaim('isSuperAdmin');
    }

    function isSuperAdmin() {
      return hasCustomClaim('isSuperAdmin');
    }

    // Only active memberships grant tenant access. Memberships written before
    // the status field existed are active.
    function isOrgMember(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS & SESSIONS
    // =========================================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isSupportAdmin() || isSuperAdmin();
      allow write: if false; // Server functions own identity, consent and suspension fields.
    }

    // Registered through registerDeviceToken/unregisterDeviceToken so a token
    // can move between accounts on a shared device without a client takeover.
    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /registrationReservations/{registrationNoNorm} {
      allow read, write: if false; // Server-owned uniqueness reservations
    }

    // =========================================================================
    // DOCTORS & PROFILES
    // =========================================================================
    match /doctors/{doctorId} {
      allow read: if isOwner(doctorId) || isVerifier() || isSupportAdmin();
      allow write: if false; // Prevent credential edits after verification.

      match /qualifications/{qualId} {
        allow read: if isOwner(doctorId) || isVerifier();
        allow write: if false;
      }

      match /specialties/{specId} {
        allow read: if isOwner(doctorId) || isVerifier();
        allow write: if false;
      }
    }

    match /doctorSchedules/{scheduleId} {
      allow read: if isAuthenticated() && (resource.data.doctorId == request.auth.uid || isSupportAdmin());
      allow write: if false; // Mutated strictly via Cloud Functions transactions
    }

    // =========================================================================
    // ORGANIZATIONS & FACILITIES
    // =========================================================================
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isVerifier() || isSupportAdmin();
      allow write: if false; // Server-owned verification and tenant fields.

      match /members/{memberUid} {
        allow read: if isOrgMember(orgId) || isSupportAdmin();
        allow write: if false; // Membership grants require audited server flow.
      }

      match /facilities/{facilityId} {
        allow read: if isOrgMember(orgId) || isVerifier();
        allow write: if false;
      }
    }

    // =========================================================================
    // DUTIES & APPLICATIONS
    // =========================================================================
    match /duties/{dutyId} {
      // Doctors can read published/filled duties; Org members can read their own
      allow read: if (isAuthenticated() && (resource.data.status in ['published', 'filled', 'in_progress', 'completed'])) ||
                     (resource != null && isOrgMember(resource.data.organizationId)) ||
                     isSupportAdmin();
      allow create, update, delete: if false; // Mutated strictly via Cloud Functions

      // Edit history (updateDuty). Written only by the server.
      match /versions/{version} {
        allow read: if isOrgMember(get(/databases/$(database)/documents/duties/$(dutyId)).data.organizationId) || isSupportAdmin();
        allow write: if false;
      }

      match /applications/{doctorId} {
        allow read: if isOwner(doctorId) || isOrgMember(get(/databases/$(database)/documents/duties/$(dutyId)).data.organizationId) || isSupportAdmin();
        allow write: if false; // Mutated strictly via Cloud Functions
      }
    }

    match /applicationSnapshots/{snapshotId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(get(/databases/$(database)/documents/duties/$(resource.data.dutyId)).data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false; // Server created only
    }

    // =========================================================================
    // ASSIGNMENTS, EVENTS & CONTACTS
    // =========================================================================
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false; // Mutated strictly via Cloud Functions
    }

    match /assignmentEvents/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false; // Server created only
    }

    match /contactGrants/{grantId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false; // Server created only
    }

    match /completionRecords/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false; // Server created only
    }

    match /paymentAcknowledgements/{ackId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false; // Server created only
    }

    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.targetId == request.auth.uid ||
        (resource.data.targetType == 'organization' && isOrgMember(resource.data.targetId)) ||
        isSupportAdmin()
      );
      allow write: if false; // Server created only
    }

    // =========================================================================
    // VERIFICATION CASES & CHECKS
    // =========================================================================
    match /verificationCases/{caseId} {
      allow read: if isAuthenticated() && (
        (resource.data.subjectType == 'doctor' && resource.data.subjectId == request.auth.uid) ||
        (resource.data.subjectType == 'organization' && isOrgMember(resource.data.subjectId)) ||
        isVerifier() || isSupportAdmin()
      );
      allow write: if false; // Mutated strictly via Cloud Functions
    }

    match /verificationChecks/{checkId} {
      allow read: if isVerifier() || isSuperAdmin();
      allow write: if false; // Server created only
    }

    match /verificationDocuments/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        isVerifier() || isSuperAdmin()
      );
      allow write: if false; // Server created only
    }

    // =========================================================================
    // OPERATIONS, AUDIT & NOTIFICATIONS
    // =========================================================================
    match /notificationOutbox/{eventId} {
      allow read, write: if false; // Server-only background trigger & worker
    }

    match /deliveryAttempts/{attemptId} {
      allow read, write: if false; // Server-only outbox delivery records
    }

    match /inboxNotifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Recipients may only mark a notification read, stamped with server time.
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']) &&
        request.resource.data.isRead == true &&
        request.resource.data.readAt == request.time;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    // Reports are filed through the rate-limited submitModerationReport callable
    // (target must exist, one open report per target) and resolved only by the
    // audited submitModerationAction callable.
    match /moderationReports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isSupportAdmin());
      allow write: if false;
    }

    // Server-only operational collections: rate-limit counters, report dedupe
    // locks, the staff role index and internal support tickets. Staff read them
    // through guarded callables, never directly.
    match /rateLimits/{counterId} {
      allow read, write: if false;
    }

    match /moderationReportLocks/{lockId} {
      allow read, write: if false;
    }

    match /staffDirectory/{uid} {
      allow read, write: if false;
    }

    match /supportCases/{caseId} {
      allow read, write: if false;
    }

    // Hospital team invitations: read and answered only through callables that
    // match the invitee by their verified phone number or email.
    match /organizationInvitations/{inviteId} {
      allow read, write: if false;
    }

    // A doctor's saved searches; created and changed only through callables (limit, normalisation).
    match /savedSearches/{searchId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isSupportAdmin() || isSuperAdmin();
      allow write: if false; // Append-only by Cloud Functions
    }

    // Platform settings change only through validated, audited callables
    // (updatePlatformConfig, setFeatureFlag), never by direct client writes.
    match /configuration/{configKey} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /featureFlags/{flag} {
      allow read: if true;
      allow write: if false;
    }

    match /appVersions/{version} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // PHASE 2 (Behind Feature Flags)
    // =========================================================================
    // Written only by flag-gated callables; direct client writes would bypass the flag.
    match /availabilityRules/{ruleId} {
      allow read: if isAuthenticated() && resource.data.doctorId == request.auth.uid;
      allow write: if false;
    }

    match /availabilityExceptions/{exceptionId} {
      allow read: if isAuthenticated() && resource.data.doctorId == request.auth.uid;
      allow write: if false;
    }

    match /reliabilitySnapshots/{snapshotId} {
      allow read: if isAuthenticated() && (resource.data.doctorId == request.auth.uid || isSupportAdmin());
      allow write: if false;
    }

    match /replacementRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin()
      );
      allow write: if false;
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource.data.openedBy == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isSupportAdmin() || isSuperAdmin()
      );
      allow write: if false;
    }
  }
}
